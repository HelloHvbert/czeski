{
  "expo": {
    "name": "Czeski",
    "slug": "czeski",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Aplikacja rozpoznaje Twoją mowę po czesku.",
        "NSMicrophoneUsageDescription": "Aplikacja używa mikrofonu do rozmów po czesku."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5FAD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.hubert.czeski",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Aplikacja używa mikrofonu do rozmów po czesku.",
          "speechRecognitionPermission": "Aplikacja rozpoznaje Twoją mowę po czesku.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "97dbf34c-afe4-4247-920e-e627f5c8fced"
      }
    },
    "owner": "hellohvbert"
  }
}
